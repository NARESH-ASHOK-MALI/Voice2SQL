# --- LLM provider: gemini | grok | openai ---
LLM_PROVIDER=gemini

# Google Gemini (free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_name_here

# xAI Grok
GROK_API_KEY=your_xai_grok_api_key_here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=your_grok_model_name_here

# OpenAI (optional / legacy)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_openai_model_name_here

# Database
DB_PATH=voice2sql.sqlite

# Rate limiting
RATE_LIMIT_QUERY_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_VOICE_PER_MIN=10
LLM_MAX_RPM=10
LLM_MAX_RETRIES=3

# CORS
ALLOWED_ORIGINS=http://localhost:5173
